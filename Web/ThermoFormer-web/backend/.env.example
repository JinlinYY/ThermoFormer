# Backend defaults are intentionally deterministic and do not require an LLM key.
LLM_PROVIDER=deterministic
LOG_LEVEL=INFO
# Optional paths (the PowerShell launcher fills these in automatically):
# THERMOFORMER_SRC=../../../src
# THERMOFORMER_CHECKPOINT=C:/path/to/checkpoint.pt
# THERMOFORMER_USE_CUDA=0
