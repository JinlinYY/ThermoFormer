# Python caches and local environments
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Editors and operating-system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local secrets
.env
.env.*
!.env.example

# Generated training products and logs
runs/
logs/
*.log
*.pt
*.pth
*.ckpt
*.npy
*.npz

# Publish formal ThermoFormer weights through Git LFS.
!checkpoints/**/*.pt
# Smoke/screening checkpoints are reproducible diagnostics, not release weights.
checkpoints/multiview/smoke/
checkpoints/multiview/screening/
checkpoints/multiview/*_exploratory/
# Publish the one V6 state-interpolation weight required to reproduce the
# known-mixture gate diagnostic; all other screening weights stay ignored.
!checkpoints/multiview/screening/
checkpoints/multiview/screening/*
!checkpoints/multiview/screening/v6_full_interaction.on.state_composition_interpolation/
checkpoints/multiview/screening/v6_full_interaction.on.state_composition_interpolation/*
!checkpoints/multiview/screening/v6_full_interaction.on.state_composition_interpolation/seed_0/
checkpoints/multiview/screening/v6_full_interaction.on.state_composition_interpolation/seed_0/*
!checkpoints/multiview/screening/v6_full_interaction.on.state_composition_interpolation/seed_0/best_model.pt

# Publish formal multi-view manifests, predictions and aggregates even though
# their protocol namespace contains a directory named "runs".
!results/multiview/
!results/multiview/formal/
!results/multiview/formal/runs/
!results/multiview/formal/runs/**
!results/multiview/predictive/
!results/multiview/predictive/runs/
!results/multiview/predictive/runs/**

# Formal multi-view manifests reference these compact training histories.
!/runs/
/runs/*
!/runs/multiview/
/runs/multiview/*
!/runs/multiview/formal/
!/runs/multiview/formal/**
!/runs/multiview/predictive/
!/runs/multiview/predictive/**

# Temporary files
*.tmp
*.temp
~$*
