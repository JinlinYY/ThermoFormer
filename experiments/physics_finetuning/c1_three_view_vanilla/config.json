{
  "extends": "../../multiview/chemical_attention/c1_three_view_vanilla/config.json",
  "name": "c1_three_view_vanilla_physics_finetune",
  "model": {
    "chemical_attention_bias": false,
    "context_pair_interaction": false
  },
  "training": {
    "epochs_physics": 5,
    "minimum_physics_epochs": 5,
    "continuity_weight": 0.00001,
    "boundary_weight": 0.001,
    "solver_weight": 0.1
  },
  "physics_finetuning": {
    "enabled": true,
    "warmup_epochs": 2,
    "trainable_modules": [
      "pair_potential",
      "vapor_pressure",
      "film",
      "mixture_token"
    ],
    "pair_potential_lr": 0.00002,
    "vapor_pressure_lr": 0.00001,
    "film_lr": 0.000005,
    "mixture_token_lr": 0.000005
  },
  "runtime": {
    "output_dir": "runs/experiments/physics_finetuning/c1_three_view_vanilla",
    "results_file": "experiments/physics_finetuning/c1_three_view_vanilla/results.md"
  }
}
