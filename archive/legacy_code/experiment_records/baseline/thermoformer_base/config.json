{
  "name": "thermoformer_base",
  "seed": 42,
  "model": {
    "hidden_dim": 192,
    "layers": 3,
    "heads": 6,
    "feedforward_multiplier": 4,
    "dropout": 0.0,
    "pair_hidden_dim": 192,
    "pure_hidden_dim": 192,
    "film_scale": 0.1,
    "use_transformer": true,
    "use_mixture_token": true,
    "use_film": true,
    "use_composition_context": true,
    "activity_mode": "excess_gibbs"
  },
  "encoder": {
    "representation": "multiview",
    "fusion_mode": "naive",
    "use_rdkit_descriptors": true,
    "use_unimol": true,
    "use_functional_groups": true,
    "chemical_attention_bias": false,
    "context_pair_interaction": false,
    "model_size": "84m",
    "batch_size": 16
  },
  "data": {
    "root": "dataset",
    "pure_property_catalog": "",
    "source_filter": "",
    "failed_weight": 0.0,
    "max_pressure_kpa": 500.0,
    "minimum_pure_anchor_temperatures": 2
  },
  "evaluation": {
    "mode": "kfold",
    "folds": 5,
    "test_fraction": 0.15,
    "validation_fraction": 0.15
  },
  "training": {
    "batch_size": 128,
    "learning_rate": 0.0002,
    "weight_decay": 0.0001,
    "epochs_supervised": 80,
    "epochs_physics": 0,
    "early_stopping_patience": 12,
    "minimum_supervised_epochs": 10,
    "minimum_physics_epochs": 0,
    "validation_min_delta": 0.0,
    "pressure_weight": 1.0,
    "pure_weight": 0.5,
    "solver_iterations_eval": 48,
    "gradient_clip": 5.0
  },
  "runtime": {
    "output_dir": "runs/experiments/baseline/thermoformer_base",
    "device": "auto",
    "results_file": "experiments/baseline/thermoformer_base/results.md"
  }
}
